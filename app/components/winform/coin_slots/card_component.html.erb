<div class="card">
  <div class="card-header">
    <div class="d-flex align-items-center">
      <div class="flex-fill">
        <h5 class="m-0">
          <i class="bi bi-cash-coin text-black"></i>
          <%= coin_slot.name %>
        </h5>
      </div>

      <div>
        <%= render Ui::StatusBadgeComponent.new(object: coin_slot) %>
      </div>
    </div>
  </div>

  <div class="card-body">
    <%= render Winform::CoinSlots::SessionComponent.new(coin_slot: coin_slot) %>
  </div>
</div>
