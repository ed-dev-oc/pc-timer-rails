<%= helpers.turbo_frame_tag dom_id(pc, :pc_session) do %>
  <% if pc_session.present? %>
    <div>
      <%= render Shared::SessionTimer::CountDownComponent.new(
        object: pc,
        session_object: pc_session,
        session_duration_ms: pc_session.total_purchased_duration_ms,
        expires_at: pc_session&.expires_at,
        size: :large) %>

      <%= render Shared::SessionTimer::ProgressBarComponent.new(
        object: pc,
        session_object: pc_session,
        session_duration_ms: pc_session.total_purchased_duration_ms,
        expires_at: pc_session&.expires_at) %>
      
      <div class="mt-1 d-none d-md-block text-end text-muted">
        <i class="bi bi-smartwatch"></i>
        <small>Total Time: </small>
        <small data-session-timer-target="totalTime"><%= pc_session.total_duration_formatted %></small>
      </div>
    </div>
  <% else %>
    <div>
      <div class="text-center py-3 bg-light rounded-3">
        <i class="bi bi-hourglass-bottom text-muted fs-1"></i>
        <p class="mb-0 small text-muted">No Active Session</p>
      </div>
    </div>
  <% end %>
<% end %>
