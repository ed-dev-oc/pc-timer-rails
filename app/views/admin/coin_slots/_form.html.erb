<%= form_with(model: [:admin, coin_slot]) do |form| %>
  <% if coin_slot.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(coin_slot.errors.count, "error") %> prohibited this coin_slot from being saved:</h2>

      <ul>
        <% coin_slot.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-2">
    <div class="form-floating mb-3">
