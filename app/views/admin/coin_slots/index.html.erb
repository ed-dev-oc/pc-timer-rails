<% content_for :title, "Coin Slots" %>

<div class="container-fluid py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h1 class="h3 mb-0">Coin Slot Management</h1>
      <p class="text-muted mb-0 small">Monitor and control all registered coin slots</p>
    </div>
    <div class="d-flex gap-2">
      <span class="badge bg-primary rounded-pill py-2 px-3">
        <i class="bi bi-gear-wide-connected me-1"></i>
        <%= @coin_slots.count %> Coin Slots
      </span>
    </div>
  </div>

  <%= turbo_stream_from "badge_status" %>

  <% if @coin_slots.empty? %>
    <div class="card">
      <div class="card-body text-center py-5">
        <i class="bi bi-gear-wide-connected text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">No Coin Slots Registered</h5>
        <p class="text-muted">Get started by registering your first coin slot.</p>
      </div>
    </div>
  <% else %>
    <div class="row g-4" id="coin_slots">
      <% @coin_slots.each do |coin_slot| %>
        <%= render coin_slot %>
      <% end %>
    </div>
  <% end %>
</div>
