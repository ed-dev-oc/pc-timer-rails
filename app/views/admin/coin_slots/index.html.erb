<p style="color: green"><%= notice %></p>

<% content_for :title, "Coin slots" %>

<h1>Coin slots</h1>

<div id="coin_slots">
  <% @coin_slots.each do |coin_slot| %>
    <%= render coin_slot %>
    <p>
      <%= link_to "Show this coin slot", [:admin, coin_slot] %>
    </p>
  <% end %>
</div>

<%= link_to "New coin slot", new_admin_coin_slot_path %>
