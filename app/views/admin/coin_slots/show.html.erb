<div class="container-fluid py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-0">
        <i class="bi bi-usb-symbol"></i>
        <%= @coin_slot.name %>
      </h2>

      <small class="text-muted">
        Device ID:
        <%= @coin_slot.device_id %>
      </small>
    </div>

    <div class="d-flex flex-column align-items-end">
      <%= turbo_stream_from "badge_status" %>

      <%= render Ui::StatusBadgeComponent.new(object: @coin_slot) %>

      <div class="btn-toolbar mt-2">
        <div class="btn-group gap-2 me-2">
          <%= link_to toggle_lock_admin_coin_slot_path(@coin_slot), 
            class: "btn #{ @coin_slot.locked? ? "btn-primary" : "btn-danger" }", 
            data: { turbo_method: :PATCH, turbo_confirm: "Are you sure?", turbo_submits_with: "Submitting..." } do %>

            <% if @coin_slot.locked? %>
              <i class="bi bi-unlock"></i>
              Unlock
            <% else %>
              <i class="bi bi-lock"></i>
              Lock
            <% end %>
          <% end %>

          <%= link_to restart_admin_coin_slot_path(@coin_slot), class: "btn btn-warning", data: { turbo_method: :POST, turbo_confirm: "Are you sure to restart the coin slot?", turbo_submits_with: "Sending..." } do %>
            <i class="bi bi-arrow-clockwise"></i>
            Restart
          <% end %>
        </div>

        <div class="dropdown">
          <button
            class="btn btn-outline-secondary dropdown-toggle"
            data-bs-toggle="dropdown">
            <i class="bi bi-three-dots"></i>
          </button>

          <ul class="dropdown-menu dropdown-menu-end">
            <li>
              <%= link_to @coin_slot.esp_url, class: "dropdown-item" do %>
                <i class="bi bi-gear"></i>
                Configure ESP
              <% end %>
            </li>
            <li>
              <hr class="dropdown-divider">
            </li>
            <li>
              <%= button_to [:admin, @coin_slot],
                method: :delete,
                form: {
                  data: {
                    turbo_confirm: "Delete this Coin Slot?",
                    turbo_submits_with: "Deleting..."
                  }
                },
                class: "dropdown-item text-danger" do %>

                <i class="bi bi-trash"></i>
                Delete

              <% end %>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="text-muted">
            Total Income
          </div>

          <h3 class="mt-2">
            ₱<%= number_with_delimiter(@stats[:total_income]) %>
          </h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="text-muted">
            Today's Income
          </div>

          <h3 class="mt-2">
            ₱<%= number_with_delimiter(@stats[:today_income]) %>
          </h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="text-muted">
            Minutes Granted
          </div>

          <h3 class="mt-2">
            <%= @stats[:total_minutes] %>
          </h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="text-muted">
            Sessions
          </div>

          <h3 class="mt-2">
            <%= @stats[:total_sessions] %>
          </h3>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-4">
      <div class="card shadow-sm">
        <div class="card-header">
          <i class="bi bi-info-circle"></i>
          Coin Slot Information
        </div>

        <div class="card-body">
          <table class="table table-sm">
            <tr>
              <th>Name</th>
              <td><%= @coin_slot.name %></td>
            </tr>

            <tr>
              <th>IP Address</th>
              <td><%= @coin_slot.ip_address %></td>
            </tr>

            <tr>
              <th>MAC Address</th>
              <td><%= @coin_slot.mac_address %></td>
            </tr>

            <tr>
              <th>Last Seen</th>
              <td><%= @coin_slot.last_seen_at ? time_ago_in_words(@coin_slot.last_seen_at) + " ago" : "Never" %></td>
            </tr>

            <tr>
              <th>Status</th>
              <td><%= @coin_slot.status.humanize %></td>
            </tr>
          </table>
        </div>
      </div>

      <div class="card shadow-sm mt-4">
        <div class="card-header">
          <i class="bi bi-hourglass-split"></i>
          Current Session
        </div>

        <div class="card-body">
          <%= turbo_stream_from "coin_slot_session" %>

          <%= render Winform::CoinSlots::SessionComponent.new(coin_slot: @coin_slot) %>
        </div>
      </div>
    </div>

    <div class="col-lg-8 d-flex flex-column gap-4">
      <%= render partial: "admin/coin_transactions/table", locals: { coin_transactions: @coin_transactions } %>

      <%= render partial: "admin/command_logs/table", locals: { command_logs: @command_logs } %>

      <%= render partial: "admin/coin_slot_sessions/table", locals: { coin_slot_sessions: @coin_slot_sessions } %>
    </div>
  </div>
</div>
