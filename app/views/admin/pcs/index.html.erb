<% content_for :title, "PCs" %>

<div class="container-fluid py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h1 class="h3 mb-0">PC Management</h1>
      <p class="text-muted mb-0 small">Monitor and control all registered PCs</p>
    </div>
    <div class="d-flex gap-2">
      <span class="badge bg-primary rounded-pill py-2 px-3">
        <i class="bi bi-collection me-1"></i>
        <%= @pcs.count %> PCs
      </span>
    </div>
  </div>

  <%= turbo_stream_from "badge_status" %>

  <% if @pcs.empty? %>
    <div class="card">
      <div class="card-body text-center py-5">
        <i class="bi bi-pc-display-horizontal text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">No PCs Registered</h5>
        <p class="text-muted">Get started by registering your first PC.</p>
      </div>
    </div>
  <% else %>
    <div class="row g-4" id="pcs">
      <% @pcs.each do |pc| %>
        <%= render pc %>
      <% end %>
    </div>
  <% end %>
</div>
