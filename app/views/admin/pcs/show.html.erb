<div class="container-fluid py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-0">
        <i class="bi bi-pc-display"></i>
        <%= @pc.name %>
      </h2>

      <small class="text-muted">
        Device ID:
        <%= @pc.device_id %>
      </small>
    </div>

    <div class="d-flex flex-column align-items-end">
      <%= turbo_stream_from "badge_status" %>

      <%= render partial: "shared/status_badge", locals: { object: @pc } %>

      <div class="btn-toolbar mt-2">
        <%= turbo_stream_from :pc_session_controls %>
        
        <div class="btn-group gap-2 me-2">
          <%= render Admin::PcSessionControlsComponent.new(pc: @pc) %>

          <%= link_to restart_admin_pc_path(@pc), class: "btn btn-warning", data: { turbo_method: :POST, turbo_confirm: "Are you sure to restart the PC?", turbo_submits_with: "Sending..." } do %>
            <i class="bi bi-arrow-clockwise"></i>
            Restart
          <% end %>

          <%= link_to shutdown_admin_pc_path(@pc), class: "btn btn-danger", data: { turbo_method: :POST, turbo_confirm: "Are you sure to shutdown the PC?", turbo_submits_with: "Sending..." } do %>
            <i class="bi bi-power"></i>
            Shutdown
          <% end %>
        </div>

        <div class="dropdown">
          <button
            class="btn btn-outline-secondary dropdown-toggle"
            data-bs-toggle="dropdown">
            <i class="bi bi-three-dots"></i>
          </button>

          <ul class="dropdown-menu dropdown-menu-end">
            <li>
              <%= button_tag type: "button", class: "dropdown-item", data: { bs_toggle: "modal", bs_target: "##{ dom_id(@pc, "edit_modal") }" } do %>
                <i class="bi bi-pencil"></i>
                Edit
              <% end %>
            </li>
            <li>
              <% if @pc.disabled_kiosk? %>
                <%= link_to enable_or_disabled_kiosk_admin_pc_path(@pc), class: "dropdown-item", data: { turbo_method: :POST, turbo_confirm: "Are you sure to enable the kiosk?", turbo_submits_with: "Submitting..."} do %>
                  <i class="bi bi-lock"></i>
                  Enable Kiosk
                <% end %>
              <% else %>
                <%= link_to enable_or_disabled_kiosk_admin_pc_path(@pc), class: "dropdown-item", data: { turbo_method: :POST, turbo_confirm: "Are you sure to disable the kiosk?", turbo_submits_with: "Submitting..."} do %>
                  <i class="bi bi-unlock"></i>
                  Disable Kiosk
                <% end %>
              <% end %>
            </li>
            <li>
              <hr class="dropdown-divider">
            </li>
            <% unless @pc.uninstalled? %>
              <li>
                <%= link_to kiosk_uninstalled_admin_pc_path(@pc), class: "dropdown-item text-danger", data: { turbo_method: :POST, turbo_confirm: "Are you sure? It means the kiosk already uninstalled.", turbo_submits_with: "Submitting..."} do %>
                  <i class="bi bi-trash"></i>
                  Kiosk Uninstalled
                <% end %>
              </li>
            <% end %>
            <li>
              <%= button_to [:admin, @pc],
                method: :delete,
                form: {
                  data: {
                    turbo_confirm: "Delete this PC?",
                    turbo_submits_with: "Deleting..."
                  }
                },
                class: "dropdown-item text-danger" do %>

                <i class="bi bi-trash"></i>
                Delete

              <% end %>
            </li>
          </ul>
        </div>

        <%= render partial: "admin/pcs/edit_modal", locals: { pc: @pc } %>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="text-muted">
            Total Income
          </div>

          <h3 class="mt-2">
            ₱<%= number_with_delimiter(@stats[:total_income]) %>
          </h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="text-muted">
            Today's Income
          </div>

          <h3 class="mt-2">
            ₱<%= number_with_delimiter(@stats[:today_income]) %>
          </h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="text-muted">
            Minutes Purchased
          </div>

          <h3 class="mt-2">
            <%= @stats[:total_minutes] %>
          </h3>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="text-muted">
            Sessions
          </div>

          <h3 class="mt-2">
            <%= @stats[:total_sessions] %>
          </h3>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-4">
      <div class="card shadow-sm">
        <div class="card-header">
          <i class="bi bi-info-circle"></i>
          PC Information
        </div>

        <div class="card-body">
          <table class="table table-sm">
            <tr>
              <th>Name</th>
              <td><%= @pc.name %></td>
            </tr>

            <tr>
              <th>IP Address</th>
              <td><%= @pc.ip_address %></td>
            </tr>

            <tr>
              <th>MAC Address</th>
              <td><%= @pc.mac_address %></td>
            </tr>

            <tr>
              <th>Last Seen</th>
              <td><%= time_ago_in_words(@pc.last_seen_at) %> ago</td>
            </tr>

            <tr>
              <th>Status</th>
              <td><%= @pc.status.humanize %></td>
            </tr>
          </table>
        </div>
      </div>

      <div class="card shadow-sm mt-4">
        <div class="card-header">
          <i class="bi bi-controller"></i>
          Current Session
        </div>

        <div class="card-body">
          <%= turbo_stream_from "pc_session" %>
          <%= render Winform::Pcs::SessionPanelComponent.new(pc: @pc) %>
        </div>
      </div>
    </div>

    <div class="col-lg-8 d-flex flex-column gap-4">
      <%= render partial: "admin/coin_transactions/table", locals: { coin_transactions: @coin_transactions } %>

      <%= render partial: "admin/command_logs/table", locals: { command_logs: @command_logs } %>

      <%= render partial: "admin/pc_sessions/table", locals: { pc_sessions: @pc_sessions } %>
    </div>
  </div>
</div>
