<div class="col-xl-3 col-lg-4 col-md-6">
  <div id="<%= dom_id pc %>" class="card h-100 border-0 shadow-sm">
    <div class="card-header bg-white py-3">
      <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <div class="bg-primary bg-opacity-10 rounded-circle p-2 text-center" style="min-height: 40px; min-width: 40px;">
            <i class="bi bi-pc-display text-primary"></i>
          </div>
          <div>
            <h6 class="mb-0"><%= pc.name %></h6>
            <small class="text-muted"><%= pc.ip_address %></small>
          </div>
        </div>
        <%= render partial: "shared/status_badge", locals: { object: pc } %>
      </div>
    </div>

    <div class="card-body">
      <div class="d-flex flex-column justify-content-between h-100">
        <%= turbo_stream_from "admin_pc_session" %>
        <%= render Admin::Pcs::SessionPanelComponent.new(pc: pc) %>

        <div class="d-flex flex-nowrap gap-2 small text-muted mt-2">
          <div>
            <i class="bi bi-clock me-1"></i>
            <span>Last seen</span>
          </div>
          <div class="flex-grow-1 text-end">
            <%= time_ago_in_words(pc.last_seen_at) %> ago
          </div>
        </div>
      </div>
    </div>

    <div class="card-footer bg-white border-top">
      <div class="btn-group w-100">
        <%= link_to [:admin, pc], class: "btn btn-primary" do %>
          <i class="bi bi-eye"></i>
          <span class="d-none d-sm-inline ms-1">View</span>
        <% end %>

        <%= turbo_stream_from :pc_session_controls %>
        <%= render Admin::PcSessionControlsComponent.new(pc: pc) %>

        <%= link_to shutdown_admin_pc_path(pc), class: "btn btn-danger", data: { turbo_method: :POST, turbo_confirm: "Are you sure to shutdown the PC?", turbo_submits_with: "Sending..." } do %>
          <i class="bi bi-power"></i>
        <% end %>
      </div>
    </div>
  </div>
</div>
