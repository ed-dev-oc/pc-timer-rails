<div class="col-xl-3 col-lg-4 col-md-6">
  <div id="<%= dom_id pc %>" class="card h-100 border-0 shadow-sm">
    <div class="card-header bg-white py-3">
      <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <div class="bg-primary bg-opacity-10 rounded-circle p-2 text-center" style="min-height: 40px; min-width: 40px;">
            <i class="bi bi-pc-display text-primary"></i>
          </div>
          <div>
            <h6 class="mb-0"><%= pc.name %></h6>
            <small class="text-muted"><%= pc.ip_address %></small>
          </div>
        </div>
        <%= render partial: "winform/pcs/shared/badge_status", locals: { pc: pc } %>
      </div>
    </div>

    <div class="card-body">
      <div class="d-flex flex-column justify-content-between h-100">
        <%= turbo_frame_tag dom_id(pc, :pc_session), class: "h-100" do %>
          <% if pc.active_pc_session.present? %>
            <div class="h-100">
              <div class="d-flex flex-column justify-content-center gap-2 mb-2 h-100"
                data-controller="session-timer"
                data-session-timer-ended-at-value="<%= pc.active_pc_session.expires_at.iso8601 %>"
                data-session-timer-total-milliseconds-expiration-value="<%= pc.active_pc_session.total_minutes_purchased * 60 * 1000 %>">

                <div class="d-flex gap-2 justify-content-between align-items-center">
                  <span class="small fw-semibold">
                    <i class="bi bi-hourglass-split me-1"></i>Time Remaining
                  </span>
                  <span class="badge bg-primary" data-session-timer-target="remaining">
                  </span>
                </div>

                <div class="progress" style="height: 25px;">
                  <div data-session-timer-target="bar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%;">
                    0%
                  </div>
                </div>
              </div>
            </div>
          <% else %>
            <div class="text-center py-3 bg-light rounded-3 mb-3">
              <i class="bi bi-hourglass-bottom text-muted"></i>
              <p class="mb-0 small text-muted">No active session</p>
            </div>
          <% end %>
        <% end %>

        <div class="d-flex flex-nowrap gap-2 small text-muted">
          <div class="">
            <i class="bi bi-clock me-1"></i>
            <span>Last seen</span>
          </div>
          <div class="flex-grow-1 text-end">
            <%= time_ago_in_words(pc.last_seen_at) %> ago
          </div>
        </div>
      </div>
    </div>

    <div class="card-footer bg-white border-top">
      <div class="btn-group w-100">
        <%= link_to [:admin, pc], class: "btn btn-outline-primary btn-sm" do %>
          <i class="bi bi-eye"></i>
          <span class="d-none d-sm-inline ms-1">View</span>
        <% end %>

        <% if pc.active_pc_session.present? %>
          <%= link_to stop_session_admin_pc_pc_session_path(pc, pc.active_pc_session, format: :html),
                      class: "btn btn-outline-warning btn-sm",
                      data: { turbo_method: :POST, turbo_submits_with: "Sending...", turbo_confirm: "Stop this session?" } do %>
            <i class="bi bi-lock"></i>
            <span class="d-none d-sm-inline ms-1">Lock</span>
          <% end %>
        <% else %>
          <%= link_to "#",
                      class: "btn btn-outline-success btn-sm",
                      data: { bs_toggle: "modal", bs_target: "##{dom_id(pc, "unlock_pc_modal")}" } do %>
            <i class="bi bi-unlock"></i>
            <span class="d-none d-sm-inline ms-1">Unlock</span>
          <% end %>

          <%= render partial: "admin/pc_sessions/unlock_modal", locals: { pc: pc } %>
        <% end %>

        <%= link_to shutdown_admin_pc_path(pc), class: "btn btn-outline-danger btn-sm", data: { turbo_method: :POST, turbo_confirm: "Are you sure to shutdown the PC?", turbo_submits_with: "Sending..." } do %>
          <i class="bi bi-power"></i>
        <% end %>
      </div>
    </div>
  </div>
</div>