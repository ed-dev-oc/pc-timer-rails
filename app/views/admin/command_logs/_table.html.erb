<div class="card shadow-sm">
  <div class="card-header">
    <i class="bi bi-terminal"></i>
    Recent Commands
  </div>

  <ul class="list-group list-group-flush overflow-auto" style="max-height: 40vh;">
    <% command_logs.each do |log| %>
			<%= render partial: "admin/command_logs/command_log", locals: { log: log } %>
    <% end %>
  </ul>
</div>
