<div class="d-flex flex-column flex-shrink-0 p-3 text-bg-dark" style="width: 280px;">
  <%= link_to admin_root_path, class: "d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none" do %>
    <%= image_tag("logo.webp",	size: "40x40", class: "me-2") %>
    <span class="fs-4">ADMIN</span>
  <% end %>
  <hr>
  <ul class="nav nav-pills flex-column mb-auto">
    <li class="nav-item">
      <%= link_to admin_root_path, class: sidebar_link_class(admin_root_path, exact: true) do %>
        <i class="bi bi-house"></i>
        Dashboard
      <% end %>
    </li>

    <li>
      <%= link_to admin_pcs_path, class: sidebar_link_class(admin_pcs_path) do %>
        <i class="bi bi-pc-display"></i>
        PCs
      <% end %>
    </li>

    <li>
      <%= link_to admin_coin_slots_path, class: sidebar_link_class(admin_coin_slots_path) do %>
        <i class="bi bi-cash-coin"></i>
        Coin Slots
      <% end %>
    </li>

    <li>
      <%= link_to admin_settings_path, class: sidebar_link_class(admin_settings_path) do %>
        <i class="bi bi-sliders"></i>
        Settings
      <% end %>
    </li>
  </ul>
</div>
