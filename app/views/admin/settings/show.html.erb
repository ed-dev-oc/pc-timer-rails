<% content_for :title, "Settings" %>

<div class="container-fluid py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h1 class="h3 mb-0">Settings</h1>
      <p class="text-muted mb-0 small">Manage application configuration values</p>
    </div>
    <span class="badge bg-primary rounded-pill py-2 px-3">
      <i class="bi bi-sliders me-1"></i>
      <%= @settings.count %> Settings
    </span>
  </div>

  <% type_badge_classes = {
    "string" => "text-bg-secondary",
    "integer" => "text-bg-primary",
    "float" => "text-bg-info",
    "boolean" => "text-bg-warning",
    "duration" => "text-bg-success"
  } %>

  <%= form_with url: admin_settings_path, method: :patch do %>
    <div class="card">
      <div class="card-header d-flex align-items-center justify-content-between">
        <span class="fw-semibold">Basic Settings</span>
        <%= button_tag type: :submit, class: "btn btn-primary btn-sm" do %>
          <i class="bi bi-check2-circle me-1"></i>
          Save Changes
        <% end %>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">Key</th>
              <th scope="col">Value</th>
              <th scope="col">Type</th>
              <th scope="col">Description</th>
            </tr>
          </thead>
          <tbody>
            <% @basic_settings.each do |setting| %>
              <tr>
                <th scope="row">
                  <code><%= setting.key %></code>
                </th>
                <td>
                  <%= text_field_tag "settings[#{setting.id}][value]",
                    setting.value,
                    class: "form-control",
                    aria: { label: "#{setting.key} value" } %>
                </td>
                <td>
                  <span class="badge <%= type_badge_classes.fetch(setting.value_type, "text-bg-secondary") %>">
                    <%= setting.value_type.titleize %>
                  </span>
                </td>
                <td>
                  <span class="text-muted"><%= setting.description %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @advanced_settings.any? %>
        <div class="card-footer border-bottom">
          <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#advancedSettings" aria-expanded="false" aria-controls="advancedSettings">
            <i class="bi bi-tools me-1"></i>
            Show Advanced Settings
          </button>
        </div>

        <div class="collapse" id="advancedSettings">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col">Key</th>
                  <th scope="col">Value</th>
                  <th scope="col">Type</th>
                  <th scope="col">Description</th>
                </tr>
              </thead>
              <tbody>
                <% @advanced_settings.each do |setting| %>
                  <tr>
                    <th scope="row">
                      <code><%= setting.key %></code>
                    </th>
                    <td>
                      <%= text_field_tag "settings[#{setting.id}][value]",
                        setting.value,
                        class: "form-control",
                        aria: { label: "#{setting.key} value" } %>
                    </td>
                    <td>
                      <span class="badge <%= type_badge_classes.fetch(setting.value_type, "text-bg-secondary") %>">
                        <%= setting.value_type.titleize %>
                      </span>
                    </td>
                    <td>
                      <span class="text-muted"><%= setting.description %></span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>

      <div class="card-footer d-flex justify-content-end">
        <%= button_tag type: :submit, class: "btn btn-primary" do %>
          <i class="bi bi-check2-circle me-1"></i>
          Save Changes
        <% end %>
      </div>
    </div>
  <% end %>
</div>
