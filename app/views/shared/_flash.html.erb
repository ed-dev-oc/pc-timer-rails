<% flash.each do |key, messages| %>
  <% Array(messages).each do |message| %>
    <div class="toast fade <%= toast_attributes(key)[:text_bg] %> border-0 mb-3 shadow"
        role="alert"
        aria-live="assertive"
        aria-atomic="true"
        data-bs-autohide="true"
        data-bs-delay="10000"
        data-controller="toast-event">

      <div class="toast-header">
        <span class="me-2">
          <%= toast_attributes(key)[:icon] %>
        </span>
        <strong class="me-auto"><%= key.titleize %></strong>
        <button type="button"
              class="btn-close"
              data-bs-dismiss="toast"
              aria-label="Close"></button>
      </div>

      <div class="toast-body">
        <%= message %>
      </div>
    </div>
  <% end %>
<% end %>
