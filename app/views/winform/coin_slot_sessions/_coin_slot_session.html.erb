<div>
  <div>
    <i class="bi bi-pc-display text-black"></i>
    <span class="fw-bold">Used By: </span>
    <span><%= coin_slot_session&.pc&.name || 'N/A' %></span>
  </div>

  <%= render Shared::SessionTimer::CountDownComponent.new(
      object: coin_slot_session&.coin_slot,
      session_object: coin_slot_session,
      session_duration_ms: Setting.duration('coin_slot_session_duration') * 1000, 
      expires_at: coin_slot_session&.ended_at) %>

  <%= render Shared::SessionTimer::ProgressBarComponent.new(
      object: coin_slot_session&.coin_slot,
      session_object: coin_slot_session,
      session_duration_ms: Setting.duration('coin_slot_session_duration') * 1000,
      expires_at: coin_slot_session&.ended_at) %>
</div>