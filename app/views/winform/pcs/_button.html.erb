<%= turbo_frame_tag dom_id(pc, :insert_coin_card) do %>
  <% if pc.has_active_coin_slot_session? %>
    <%= link_to cancel_winform_pc_coin_slot_sessions_path(pc.device_id),
          class: "btn btn-danger",
          data: { turbo_frame: :_top, turbo_method: :PATCH, turbo_submits_with: "Sending..." } do %>
      <i class="bi bi-x-circle"></i>
      Cancel Inserting Coin
    <% end %>

    <% if pc.active_pc_session.present? %>
      <%= link_to winform_pc_pc_session_path(pc.device_id, pc.active_pc_session),
            class: "btn btn-primary",
            data: { turbo_frame: :_top, turbo_method: :PATCH, turbo_submits_with: "Sending..."} do %>
        <i class="bi bi-plus-circle"></i>
        Extend Time!
      <% end %>
    <% else %>
      <%= link_to winform_pc_pc_sessions_path(pc.device_id),
            class: "btn btn-success",
            data: { turbo_frame: :_top, turbo_method: :POST, turbo_submits_with: "Sending..." } do %>
        <i class="bi bi-dash-circle"></i>
        Use Credit!
      <% end %>
    <% end %>
  <% else %>
    <%= link_to winform_pc_coin_slot_sessions_path(pc.device_id),
        class: "btn btn-primary",
        data: { turbo_frame: :_top, turbo_method: :POST, turbo_submits_with: "Sending..." } do %>
      <i class="bi bi-plus-circle"></i>
      Insert Coin
    <% end %>

    <% if pc.has_unused_coin_transaction? %>
      <%= link_to winform_pc_pc_sessions_path(pc.device_id),
            class: "btn btn-success",
            data: { turbo_frame: :_top, turbo_method: :POST, turbo_submits_with: "Sending..." } do %>
        <i class="bi bi-dash-circle"></i>
        Use Credit!
      <% end %>
    <% end %>
  <% end %>
<% end %>
