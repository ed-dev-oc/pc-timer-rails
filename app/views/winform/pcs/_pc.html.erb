<%= turbo_frame_tag dom_id(pc) do %>
  <div class="card">
    <div class="card-header">
      <div class="d-flex">
        <div class="flex-fill">
          <h5 class="m-0">
            <i class="bi bi-pc-display text-black"></i>
            <%= pc.name %>
          </h5>
        </div>
        <div>
          <%= render partial: "shared/status_badge", locals: { object: pc } %>
        </div>
      </div>
    </div>
    <div class="card-body">
      <div class="mb-3 py-2 border-bottom">
        <div>
          <i class="bi bi-clock-history"></i>
          <span class="fw-bold">Last seen at: </span>
          <span><%= pc.last_seen_at&.strftime("%B %d, %Y %I:%M:%S %p") %></span>
        </div>
        <div>
          <i class="bi bi-globe"></i>
          <span class="fw-bold">IP Address: </span>
          <span><%= pc.ip_address %></span>
        </div>
        <div>
          <i class="bi bi-hdd-network"></i>
          <span class="fw-bold">Mac Address: </span>
          <span><%= pc.mac_address %></span>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <h5>
            <i class="bi bi-hourglass-split"></i>
            Time Session
          </h5>
          <%= turbo_stream_from "pc_session" %>
          <%= render Winform::Pcs::SessionPanelComponent.new(pc: pc) %>
        </div>
      </div>
    </div>
  </div>
<% end %>
