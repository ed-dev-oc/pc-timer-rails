
<div class="row gy-2 my-3">
  <%= turbo_stream_from "badge_status" %>

  <div class="col-12 col-md-6">
    <div>
      <%= turbo_stream_from "pc_card" %>
      <%= render partial: "winform/pcs/card", locals: { pc: @pc, pc_session: @pc_session } %>
    </div>
  </div>
  <div class="col-12 col-md-6 d-flex flex-column gap-2">
    <div>
      <%= turbo_stream_from "coin_slot_session" %>

      <div id="coin_slots">
        <% @coin_slots.each do |coin_slot| %>
          <%= render partial: "winform/coin_slots/coin_slot", locals: { coin_slot: coin_slot } %>
        <% end %>
      </div>
    </div>
    <div>
      <%= turbo_stream_from "coin_slot_button" %>
      <%= turbo_stream_from "pc_session_button" %>

      <div class="card">
        <div class="card-body">
          <div class="d-flex gap-2">
            <p class="fw-bold m-0">
              <i class="bi bi-coin"></i>
              Unused Coin:
            </p>
            <%= render partial: "winform/coin_transactions/total_amount_badge", locals: { pc: @pc } %>
          </div>
          <hr>
          <%= render(Winform::Pc::CoinSlotSessionButtonComponent.new(pc: @pc)) %>
          <%= render(Winform::Pc::PcSessionButtonComponent.new(pc: @pc)) %>
        </div>
      </div>
    </div>
  </div>
</div>
