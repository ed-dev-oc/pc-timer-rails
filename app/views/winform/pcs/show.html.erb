
<div class="row gy-2 my-3">
  <%= turbo_stream_from "badge_status" %>

  <div class="col-12 col-md-6">
    <div>
      <%= render @pc %>
    </div>
  </div>
  <div class="col-12 col-md-6 d-flex flex-column gap-2">
    <div>
      <%= turbo_stream_from "coin_slot_session" %>

      <div id="coin_slots">
        <% @coin_slots.each do |coin_slot| %>
          <%= render coin_slot %>
        <% end %>
      </div>
    </div>
    <div>
      <div class="card">
        <div class="card-body">
          <div class="d-flex gap-2">
            <p class="fw-bold m-0">
              <i class="bi bi-coin"></i>
              Unused Coin:
            </p>
            <%= turbo_stream_from "coin_transaction" %>
            <%= render(Winform::CoinTransactions::TotalAmountBadgeComponent.new(pc: @pc)) %>
          </div>
          <hr>
          <%= turbo_stream_from "coin_slot_button" %>
          <%= turbo_stream_from "pc_session_button" %>

          <%= render(Winform::Pcs::CoinSlotSessionButtonComponent.new(pc: @pc)) %>
          <%= render(Winform::Pcs::PcSessionButtonComponent.new(pc: @pc)) %>
        </div>
      </div>
    </div>
  </div>
</div>
