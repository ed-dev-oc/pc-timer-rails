<%= turbo_frame_tag dom_id(pc, :pc_session) do %>
  <% if pc_session.present? %>
    <div data-controller="session-timer"
                data-session-timer-ended-at-value="<%= pc_session.expires_at.iso8601 %>"
                data-session-timer-total-milliseconds-expiration-value="<%= pc_session.total_minutes_purchased * 60 * 1000 %>">

      <div class="d-flex align-items-center justify-content-center justify-content-md-start">
        <div data-session-timer-target="remaining" class="fs-1 fw-bold text-success"></div>
      </div>

      <div class="progress d-none d-md-flex" style="height: 25px;">
        <div data-session-timer-target="bar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%;">
          0%
        </div>
      </div>

      <div class="mt-2 d-none d-md-block text-end">
        <i class="bi bi-smartwatch"></i>
        <span>Total Time: </span>
        <span data-session-timer-target="totalTime"></span>
      </div>
    </div>
  <% else %>
    <div>
      <div class="d-flex gap-2 align-items-center justify-content-center justify-content-md-start">
        <div data-session-timer-target="remaining" class="fs-1 fw-bold text-success">00:00:00</div>
      </div>

      <div class="progress d-none d-md-flex" style="height: 25px;">
        <div data-session-timer-target="bar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%;">0%</div>
      </div>

      <div class="mt-2 d-none d-md-block text-end">
        <i class="bi bi-smartwatch"></i>
        <small class="text-muted">Total Time: </small>
        <small class="text-muted" data-session-timer-target="totalTime">00:00:00</small>
      </div>
    </div>
  <% end %>
<% end %>
