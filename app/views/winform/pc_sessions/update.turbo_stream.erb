<%= turbo_stream.replace :flash_messages do %>
  <%= render Shared::Flash::ContainerComponent.new(flash: flash) %>
<% end %>

<%= turbo_stream.update dom_id(@pc) do %>
  <%= render partial: "winform/pcs/card", locals: { pc: @pc, pc_session: @pc_session } %>
<% end %>

<%= turbo_stream.update dom_id(@pc, :insert_coin_card) do %>
  <%= render partial: "winform/pcs/button", locals: { pc: @pc } %>
<% end %>
