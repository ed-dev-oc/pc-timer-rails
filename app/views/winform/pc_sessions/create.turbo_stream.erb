<%= turbo_stream.replace :flash_messages do %>
  <%= render Shared::Flash::ContainerComponent.new(flash: flash) %>
<% end %>

<%= turbo_stream.update dom_id(@pc, :pc_session) do %>
  <%= render Winform::Pcs::SessionPanelComponent.new(pc: @pc) %>
<% end %>

<%= turbo_stream.replace dom_id(@pc, :badge_status),
  partial: "shared/status_badge",
  locals: { object: @pc } %>

<%= turbo_stream.replace dom_id(@pc, :coin_slot_button) do %>
  <%= render(Winform::Pcs::CoinSlotSessionButtonComponent.new(pc: @pc)) %>
<% end %>

<%= turbo_stream.replace dom_id(@pc, :pc_session_button) do %>
  <%= render(Winform::Pcs::PcSessionButtonComponent.new(pc: @pc)) %>
<% end %>

<%= turbo_stream.replace dom_id(@pc, :inserted_amount) do %>
  <%= render(Winform::CoinTransactions::TotalAmountBadgeComponent.new(pc: @pc)) %>
<% end %>
