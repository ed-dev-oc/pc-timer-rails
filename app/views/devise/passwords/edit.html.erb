<div class="row justify-content-center">
  <div class="col-12 col-md-6 col-lg-4">
    <div class="card shadow">
      <div class="card-body p-4">
        <h2 class="card-title text-center mb-4"><%= Setting.string('business_name') %></h2>
        <h3 class="h5 text-center mb-4">Change your password</h3>

        <%= render "devise/shared/error_messages", resource: resource %>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
          <%= f.hidden_field :reset_password_token %>

          <div class="input-group mb-3" data-controller="password-visibility">
            <div class="form-floating flex-grow-1">
              <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control", id: "floatingPassword", placeholder: " ", data: { "password-visibility-target": "input" } %>
              <%= f.label :password, "New password", for: "floatingPassword" %>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-action="password-visibility#toggle">
              <i class="bi bi-eye" data-password-visibility-target="toggleIcon"></i>
            </button>
          </div>

          <% if @minimum_password_length %>
            <div class="form-text mb-3">
              <%= @minimum_password_length %> characters minimum
            </div>
          <% end %>

          <div class="input-group mb-3" data-controller="password-visibility">
            <div class="form-floating flex-grow-1">
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", id: "floatingPasswordConfirmation", placeholder: " ", data: { "password-visibility-target": "input" } %>
              <%= f.label :password_confirmation, "Confirm new password", for: "floatingPasswordConfirmation" %>
            </div>
            <button type="button" class="btn btn-outline-secondary" data-action="password-visibility#toggle">
              <i class="bi bi-eye" data-password-visibility-target="toggleIcon"></i>
            </button>
          </div>

          <div class="d-grid">
            <%= f.submit "Change my password", class: "btn btn-primary" %>
          </div>
        <% end %>

        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
