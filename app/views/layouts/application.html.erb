<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || Setting.string('business_name') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= Setting.string('business_name') %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-title" content="<%= Setting.string('app_name') %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <nav class="navbar border-bottom">
      <div class="container">
        <div class="d-flex align-items-center w-100">
          <div class="d-flex align-items-center flex-grow-1">
            <%= image_tag("logo.webp", height: "60", class: "navbar-brand", alt: "Logo") %>
            <span class="d-flex flex-column">
                <strong class="fs-6"><%= Setting.string('business_name') %></strong>
                <small class="text-muted"><%= Setting.string('app_name') %></small>
            </span>
          </div>
        </div>
      </div>
    </nav>

    <main id="main" class="container flex-fill py-5 h-100">
      <%= yield %>
    </main>

    <%= render Shared::Flash::ContainerComponent.new(flash: flash) %>
  </body>
</html>
