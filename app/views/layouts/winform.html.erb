<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || Setting.string('business_name') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= Setting.string('business_name') %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-title" content="<%= Setting.string('app_name') %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="vh-100">
    <nav class="navbar d-none d-sm-block">
      <div class="container border-2 border-bottom border-primary">
        <div class="d-flex align-items-center w-100">
          <div class="d-flex align-items-center flex-grow-1">
            <%= image_tag("logo.webp", height: "60", class: "navbar-brand") %>
            <span>
              <span class="fw-bold fs-2"><%= Setting.string('business_name') %></span>
              <span>-</span>
              <small class="text-muted fs-6"><%= Setting.string('app_name') %></small>
            </span>
          </div>
          <div class="">
            <%= link_to winform_pc_path(@pc), class: "btn btn-sm btn-primary" do %>
              <i class="bi bi-arrow-clockwise"></i>
              Reload
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main id="main" class="container flex-fill">
      <%= yield %>
    </main>

    <div class="toast-container p-3 position-absolute bottom-0 end-0">
      <%= turbo_frame_tag :flash_messages do %>
        <%= render partial: "shared/flash" %>
      <% end %>
    </div>
  </body>
</html>
