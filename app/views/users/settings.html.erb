<div class="row justify-content-center my-4">
  <div class="col-12 col-lg-8 col-xl-7">
    <div class="card shadow-sm border-0 rounded-3">
      <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-3">
        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
          <i class="bi bi-person-gear fs-4"></i>
        </div>
        <div>
          <h4 class="mb-0 fw-bold text-dark">Account Settings</h4>
          <p class="text-muted mb-0 small">Update your email address and security password</p>
        </div>
      </div>

      <div class="card-body p-4">
        <% if @user.errors.any? %>
          <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <h5 class="alert-heading fw-bold d-flex align-items-center gap-2 mb-2">
              <i class="bi bi-exclamation-triangle-fill"></i>
              Please correct the following errors:
            </h5>
            <ul class="mb-0 ps-3">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>

        <%= form_with(model: @user, url: update_settings_path, method: :patch, local: true) do |form| %>
          <div class="mb-4">
            <h5 class="text-dark fw-bold mb-3 d-flex align-items-center gap-2">
              <i class="bi bi-envelope text-secondary"></i>
              Account Identity
            </h5>
            <div class="form-floating">
              <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "form-control #{"is-invalid" if @user.errors[:email].any?}", id: "floatingEmail", placeholder: "email@example.com" %>
              <%= form.label :email, "Email Address", for: "floatingEmail" %>
              <% if @user.errors[:email].any? %>
                <div class="invalid-feedback">
                  <%= @user.errors[:email].join(", ") %>
                </div>
              <% end %>
            </div>
          </div>

          <hr class="my-4 text-muted opacity-25">

          <div class="mb-4">
            <h5 class="text-dark fw-bold mb-2 d-flex align-items-center gap-2">
              <i class="bi bi-shield-lock text-secondary"></i>
              Security Settings
            </h5>
            <p class="text-muted small mb-3">Leave password fields blank if you do not wish to change your password.</p>

            <div class="row g-3">
              <div class="col-12 col-md-6">
                <div class="input-group" data-controller="password-visibility">
                  <div class="form-floating flex-grow-1 <%= "is-invalid" if @user.errors[:password].any? %>">
                    <%= form.password_field :password, autocomplete: "new-password", class: "form-control #{"is-invalid" if @user.errors[:password].any?}", id: "floatingPassword", placeholder: "New Password", data: { "password-visibility-target": "input" } %>
                    <%= form.label :password, "New Password", for: "floatingPassword" %>
                  </div>
                  <button type="button" class="btn btn-outline-secondary d-flex align-items-center" data-action="password-visibility#toggle" tabindex="-1">
                    <i class="bi bi-eye" data-password-visibility-target="toggleIcon"></i>
                  </button>
                  <% if @user.errors[:password].any? %>
                    <div class="invalid-feedback">
                      <%= @user.errors[:password].join(", ") %>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="col-12 col-md-6">
                <div class="input-group" data-controller="password-visibility">
                  <div class="form-floating flex-grow-1 <%= "is-invalid" if @user.errors[:password_confirmation].any? %>">
                    <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "form-control #{"is-invalid" if @user.errors[:password_confirmation].any?}", id: "floatingPasswordConfirmation", placeholder: "Confirm Password", data: { "password-visibility-target": "input" } %>
                    <%= form.label :password_confirmation, "Confirm New Password", for: "floatingPasswordConfirmation" %>
                  </div>
                  <button type="button" class="btn btn-outline-secondary d-flex align-items-center" data-action="password-visibility#toggle" tabindex="-1">
                    <i class="bi bi-eye" data-password-visibility-target="toggleIcon"></i>
                  </button>
                  <% if @user.errors[:password_confirmation].any? %>
                    <div class="invalid-feedback">
                      <%= @user.errors[:password_confirmation].join(", ") %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <div class="d-flex align-items-center justify-content-between pt-3 border-top">
            <%= link_to current_user.admin? ? admin_root_path : root_path, class: "btn btn-link text-decoration-none text-secondary d-flex align-items-center gap-1" do %>
              <i class="bi bi-arrow-left"></i> Back to Dashboard
            <% end %>
            <%= form.submit "Save Changes", class: "btn btn-primary px-4 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
